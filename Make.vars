NAME = devilspie2
PROG = $(BIN)/$(NAME)
VERSION = $(shell cat ./VERSION)
DATADIR = ${DESTDIR}${PREFIX}/share
LOCALEDIR = ${DATADIR}/locale
MANDIR = ${DATADIR}/man
# /etc if installing in /usr, else ${PREFIX}/etc
# if this isn't right, submit a patch
ETCDIR = ${DESTDIR}$(if $(patsubst /usr,,${PREFIX}),${PREFIX},)/etc
APPDIR = ${ETCDIR}/xdg/autostart
MANPAGE = ${NAME}.1

ifndef PREFIX
	ifdef INSTALL_PREFIX
		PREFIX=$(INSTALL_PREFIX)
	else
		PREFIX=/usr/local
	endif
endif

ifeq ($(V),0)
else
ifeq ($(V),1)
else
V=0
endif
endif

V_at = $(__v_at_$(V))
__v_at_ = $(__v_at_$(V))
__v_at_0 = @
__v_at_1 = 

define make_V =
V_$(1) = $$(__v_$(1)_$(V))
__v_$(1)_ = $$(__v_$(1)_$(V))
__v_$(1)_0 = @echo $(shell printf "\"  %-8s\"" $(1)) $(if $(3),$(3),$$@); 
__v_$(1)_1 =
endef
